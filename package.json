{
  "name": "be-bolao-vue-ts",
  "version": "1.0.0",
  "description": "Bolao BE in NodeJS with TypeScript and Express",
  "type": "module",
  "files": [
    "dist/**"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/index.ts",
    "start": "node --env-file .env dist/src/index.js",
    "start:prod": "pm2 start \"node --env-file=.env index.js\" --watch",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "postbuild": "cp package.json dist/",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "check": "run-s type-check \"lint\" \"format:check\" \"test:run\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelipeZNascimento/be-bolao-vue-ts.git"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "oxfmt --check"
    ],
    "*.{json,yml,yaml,md}": [
      "oxfmt --check"
    ]
  },
  "keywords": [],
  "author": "Felipe Zanon do Nascimento",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FelipeZNascimento/be-bolao-vue-ts/issues"
  },
  "homepage": "https://github.com/FelipeZNascimento/be-bolao-vue-ts#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "mysql2": "^3.16.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.5",
    "websocket-express": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-mysql-session": "^3.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "imports": {
    "#*": "./src/*"
  },
  "engines": {
    "node": "23.7.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
